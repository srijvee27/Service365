# ==============================================================================
# Service365 Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL - Neon / Cloud / Local)
# ------------------------------------------------------------------------------
# Neon Connection String format:
# postgresql://[user]:[password]@[endpoint].pooler.neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/service365"

# ------------------------------------------------------------------------------
# 2. Application & Authentication Secrets
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="service365-super-secret-jwt-key-change-in-production-min-32-chars"

# ------------------------------------------------------------------------------
# 3. Payment Gateway Configuration (bKash)
# ------------------------------------------------------------------------------
# Set to 'mock' for local sandbox testing without official credentials.
# Set to 'bkash' for official bKash Merchant API integration.
PAYMENT_MODE="mock"
MOCK_BKASH="true"

# Official bKash Merchant Credentials (Required if PAYMENT_MODE=bkash)
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"

# ------------------------------------------------------------------------------
# 4. Transactional Notifications (Email & SMS)
# ------------------------------------------------------------------------------
# Email Provider (SMTP)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="2525"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@service365.com.bd"

# SMS Provider ('mock' for development logging, 'bangladesh_sms' for live gateways)
SMS_PROVIDER="mock"
SMS_API_KEY=""
SMS_SENDER_ID="Service365"

# ------------------------------------------------------------------------------
# 5. Maps & Storage Abstractions
# ------------------------------------------------------------------------------
MAPS_PROVIDER="osm"
MAPS_API_KEY=""

STORAGE_PROVIDER="mock"
STORAGE_BUCKET=""
