// ==============================================================================
// Service365 Prisma Schema
// PostgreSQL (Neon Cloud / Local)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  SUPPORT
  MERCHANT
  RIDER
  CUSTOMER
}

enum MerchantStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum RiderStatus {
  AVAILABLE
  BUSY
  OFFLINE
  SUSPENDED
}

enum ZoneType {
  INSIDE_DHAKA
  DHAKA_SUBURB
  OUTSIDE_DHAKA
}

enum ServiceType {
  REGULAR
  EXPRESS
  SAME_DAY
}

enum OrderStatus {
  ORDER_CREATED
  ORDER_CONFIRMED
  PICKUP_REQUESTED
  PICKED_UP
  AT_SORTING_CENTER
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RETURN_REQUESTED
  RETURN_IN_TRANSIT
  RETURNED
  CANCELLED
}

enum PaymentMethod {
  COD
  BKASH
  ONLINE
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum CodStatus {
  PENDING
  COLLECTED
  SETTLEMENT_PENDING
  SETTLED
  FAILED
}

enum SettlementStatus {
  PENDING
  PROCESSING
  SETTLED
  REJECTED
}

enum ReturnStatus {
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURN_PICKUP
  RETURN_IN_TRANSIT
  RETURNED
  RETURN_CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WalletTransactionType {
  COD_CREDIT
  DELIVERY_FEE_DEBIT
  RETURN_FEE_DEBIT
  PAYOUT_DEBIT
  ADJUSTMENT
}

// ------------------------------------------------------------------------------
// USER & IDENTITY
// ------------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  phone         String    @unique
  passwordHash  String
  role          Role      @default(CUSTOMER)
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  phoneVerified Boolean   @default(false)
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  merchant      Merchant?
  rider         Rider?
  customer      Customer?
  notifications Notification[]
  tickets       SupportTicket[]
  messages      SupportMessage[]
  auditLogs     AuditLog[]

  @@index([email])
  @@index([phone])
  @@index([role])
}

model Merchant {
  id                String          @id @default(cuid())
  userId            String          @unique
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName      String
  tradeLicenseNo    String?
  contactPerson     String?
  status            MerchantStatus  @default(PENDING)
  verificationNotes String?

  paymentMethod     String?         // "BANK" or "BKASH"
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  bankBranch        String?
  bankRoutingNumber String?
  bkashNumber       String?

  stores            MerchantStore[]
  orders            Order[]
  returns           Return[]
  codTransactions   CodTransaction[]
  settlements       Settlement[]
  wallet            Wallet?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([status])
}

model MerchantStore {
  id          String   @id @default(cuid())
  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name        String
  phone       String
  district    String
  area        String
  fullAddress String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([merchantId])
}

model Customer {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultAddress  String?
  defaultDistrict String?
  defaultArea     String?
  orders          Order[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Rider {
  id             String            @id @default(cuid())
  userId         String            @unique
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType    String            // "BIKE", "CYCLE", "VAN"
  licenseNumber  String?
  nidNumber      String?
  currentZone    ZoneType          @default(INSIDE_DHAKA)
  status         RiderStatus       @default(AVAILABLE)
  cashInHand     Decimal           @default(0.00) @db.Decimal(12, 2)
  assignments    RiderAssignment[]
  locations      RiderLocation[]
  deliveryProofs DeliveryProof[]
  returns        Return[]
  codCollections CodTransaction[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status])
  @@index([currentZone])
}

// ------------------------------------------------------------------------------
// GEOGRAPHIC & SERVICE COVERAGE
// ------------------------------------------------------------------------------

model Division {
  id        String     @id @default(cuid())
  name      String     @unique
  bnName    String
  districts District[]
}

model District {
  id                 String   @id @default(cuid())
  divisionId         String
  division           Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  name               String   @unique
  bnName             String
  zoneType           ZoneType @default(OUTSIDE_DHAKA)
  active             Boolean  @default(true)
  deliveryTimeHours  Int      @default(48)
  areas              Area[]
  createdAt          DateTime @default(now())

  @@index([zoneType])
  @@index([active])
}

model Area {
  id              String   @id @default(cuid())
  districtId      String
  district        District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  name            String
  bnName          String
  postCode        String?
  active          Boolean  @default(true)
  expressAvailable Boolean @default(false)
  createdAt       DateTime @default(now())

  @@unique([districtId, name])
  @@index([districtId])
  @@index([active])
}

model Service {
  id                String      @id @default(cuid())
  code              ServiceType @unique
  name              String
  description       String
  active            Boolean     @default(true)
  baseLeadTimeHours Int         @default(24)
  createdAt         DateTime    @default(now())
}

// ------------------------------------------------------------------------------
// PRICING ENGINE
// ------------------------------------------------------------------------------

model PricingRule {
  id                     String      @id @default(cuid())
  fromZone               ZoneType
  toZone                 ZoneType
  serviceType            ServiceType @default(REGULAR)
  minWeight              Decimal     @default(0.00) @db.Decimal(8, 2) // kg
  maxWeight              Decimal     @default(1.00) @db.Decimal(8, 2) // kg
  baseCharge             Decimal     @db.Decimal(10, 2)              // BDT
  additionalWeightCharge Decimal     @db.Decimal(10, 2)              // BDT per extra kg
  codPercentage          Decimal     @default(1.00) @db.Decimal(5, 2)// % (e.g. 1.00%)
  taxPercentage          Decimal     @default(0.00) @db.Decimal(5, 2)// %
  active                 Boolean     @default(true)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@unique([fromZone, toZone, serviceType])
  @@index([fromZone, toZone])
}

// ------------------------------------------------------------------------------
// ORDERS & LIFECYCLE
// ------------------------------------------------------------------------------

model Order {
  id                   String            @id @default(cuid())
  orderId              String            @unique @default(dbgenerated("('#'::text || nextval('order_id_seq'::regclass))"))
  orderNumber          String            @unique // e.g. S365-2026-000001
  trackingId           String            @unique // e.g. S365BD7K9F2L
  merchantId           String?
  merchant             Merchant?         @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  customerId           String?
  customer             Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Sender details
  senderName           String
  senderPhone          String
  senderDistrict       String
  senderArea           String
  senderAddress        String
  pickupInstructions   String?

  // Recipient details
  receiverName         String
  receiverPhone        String
  receiverDistrict     String
  receiverArea         String
  receiverAddress      String
  deliveryInstructions String?

  // Parcel specifications
  productType          String            @default("GENERAL")
  productDescription   String?
  quantity             Int               @default(1)
  weight               Decimal           @db.Decimal(8, 2) // in kg
  declaredValue        Decimal?          @db.Decimal(12, 2)

  // Service & Pricing breakdown (all server calculated)
  serviceType          ServiceType       @default(REGULAR)
  baseCharge           Decimal           @db.Decimal(10, 2)
  weightCharge         Decimal           @default(0.00) @db.Decimal(10, 2)
  codFee               Decimal           @default(0.00) @db.Decimal(10, 2)
  taxAmount            Decimal           @default(0.00) @db.Decimal(10, 2)
  discountAmount       Decimal           @default(0.00) @db.Decimal(10, 2)
  totalCharge          Decimal           @db.Decimal(10, 2)

  // Payment & COD
  paymentMethod        PaymentMethod     @default(COD)
  paymentStatus        PaymentStatus     @default(PENDING)
  codAmount            Decimal           @default(0.00) @db.Decimal(12, 2)
  codStatus            CodStatus         @default(PENDING)

  // Status & Timeline
  status               OrderStatus       @default(ORDER_CREATED)
  estimatedDelivery    DateTime?
  deliveredAt          DateTime?

  // Return handling
  isReturn             Boolean           @default(false)
  returnReason         String?
  parentOrderId        String?

  // Booking / Order Date (business date)
  orderDate            DateTime          @default(now())

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  items                OrderItem[]
  trackingEvents       TrackingEvent[]
  assignments          RiderAssignment[]
  deliveryProofs       DeliveryProof[]
  payments             Payment[]
  codTransactions      CodTransaction[]
  returns              Return[]

  @@index([trackingId])
  @@index([orderNumber])
  @@index([merchantId])
  @@index([status])
  @@index([receiverPhone])
  @@index([createdAt])
  @@index([orderDate])
  @@index([orderId])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name        String
  quantity    Int      @default(1)
  unitPrice   Decimal  @default(0.00) @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  @@index([orderId])
}

model TrackingEvent {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  message     String
  location    String?
  actorId     String?
  actorRole   Role?
  createdAt   DateTime    @default(now())

  @@index([orderId])
  @@index([createdAt])
}

model RiderAssignment {
  id             String    @id @default(cuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  riderId        String
  rider          Rider     @relation(fields: [riderId], references: [id], onDelete: Cascade)
  assignmentType String    // "PICKUP" or "DELIVERY"
  status         String    @default("ASSIGNED") // "ASSIGNED", "ACCEPTED", "COMPLETED", "REASSIGNED"
  assignedAt     DateTime  @default(now())
  completedAt    DateTime?

  @@index([orderId])
  @@index([riderId])
}

model RiderLocation {
  id        String   @id @default(cuid())
  riderId   String
  rider     Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)
  orderId   String?
  latitude  Float
  longitude Float
  accuracy  Float?
  createdAt DateTime @default(now())

  @@index([riderId])
}

model DeliveryProof {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  riderId   String
  rider     Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)
  type      String   // "OTP", "SIGNATURE", "PHOTO"
  fileUrl   String?
  otp       String?
  notes     String?
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([riderId])
}

// ------------------------------------------------------------------------------
// PAYMENTS & FINANCIAL LEDGER
// ------------------------------------------------------------------------------

model Payment {
  id               String        @id @default(cuid())
  orderId          String
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod    PaymentMethod
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("BDT")
  status           PaymentStatus @default(INITIATED)
  gatewayPaymentId String?
  transactionId    String?       @unique
  gatewayResponse  String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([transactionId])
}

model CodTransaction {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  merchantId  String
  merchant    Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  riderId     String?
  rider       Rider?    @relation(fields: [riderId], references: [id], onDelete: SetNull)
  amount      Decimal   @db.Decimal(12, 2)
  codFee      Decimal   @db.Decimal(10, 2)
  netAmount   Decimal   @db.Decimal(12, 2) // amount - codFee - deliveryFee
  status      CodStatus @default(PENDING)
  collectedAt DateTime?
  settledAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([orderId])
  @@index([merchantId])
  @@index([status])
}

model Wallet {
  id               String              @id @default(cuid())
  merchantId       String              @unique
  merchant         Merchant            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  availableBalance Decimal             @default(0.00) @db.Decimal(12, 2)
  pendingBalance   Decimal             @default(0.00) @db.Decimal(12, 2)
  totalWithdrawn   Decimal             @default(0.00) @db.Decimal(12, 2)
  transactions     WalletTransaction[]
  updatedAt        DateTime            @updatedAt
}

model WalletTransaction {
  id            String                @id @default(cuid())
  walletId      String
  wallet        Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type          WalletTransactionType
  amount        Decimal               @db.Decimal(12, 2)
  balanceAfter  Decimal               @db.Decimal(12, 2)
  referenceType String?               // "ORDER", "SETTLEMENT", "ADJUSTMENT"
  referenceId   String?
  notes         String?
  createdAt     DateTime              @default(now())

  @@index([walletId])
  @@index([createdAt])
}

model Settlement {
  id                   String           @id @default(cuid())
  settlementNumber     String           @unique // e.g. STL-2026-000001
  merchantId           String
  merchant             Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  amount               Decimal          @db.Decimal(12, 2)
  paymentMethod        String           // "BANK" or "BKASH"
  destinationAccount   String
  status               SettlementStatus @default(PENDING)
  approvedBy           String?
  transactionReference String?
  notes                String?
  processedAt          DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([merchantId])
  @@index([status])
}

model Return {
  id           String       @id @default(cuid())
  orderId      String
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  merchantId   String
  merchant     Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  riderId      String?
  rider        Rider?       @relation(fields: [riderId], references: [id], onDelete: SetNull)
  reason       String
  status       ReturnStatus @default(RETURN_REQUESTED)
  returnFee    Decimal      @default(0.00) @db.Decimal(10, 2)
  notes        String?
  returnedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([orderId])
  @@index([merchantId])
  @@index([status])
}

// ------------------------------------------------------------------------------
// SUPPORT & COMMUNICATIONS
// ------------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  channel   String   @default("IN_APP") // "IN_APP", "SMS", "EMAIL"
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
}

model NotificationTemplate {
  id            String   @id @default(cuid())
  eventName     String   @unique
  channel       String   // "SMS", "EMAIL"
  subject       String?
  bodyTemplate  String   @db.Text
  active        Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

model SupportTicket {
  id           String           @id @default(cuid())
  ticketNumber String           @unique // e.g. TKT-2026-0001
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject      String
  category     String           // "BILLING", "DELIVERY", "COD", "TECHNICAL"
  priority     TicketPriority   @default(MEDIUM)
  status       TicketStatus     @default(OPEN)
  messages     SupportMessage[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([userId])
  @@index([status])
}

model SupportMessage {
  id          String        @id @default(cuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderRole  Role
  message     String        @db.Text
  attachments String?
  createdAt   DateTime      @default(now())

  @@index([ticketId])
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  discountType  String    // "PERCENTAGE" or "FIXED"
  discountValue Decimal   @db.Decimal(10, 2)
  minOrderValue Decimal?  @db.Decimal(10, 2)
  maxDiscount   Decimal?  @db.Decimal(10, 2)
  expiresAt     DateTime?
  active        Boolean   @default(true)
  usageCount    Int       @default(0)
  createdAt     DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  role      Role?
  action    String
  entity    String
  entityId  String?
  before    String?  @db.Text
  after     String?  @db.Text
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
}
